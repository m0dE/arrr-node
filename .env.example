# arrr-node configuration. Copy to .env and fill in. Every value is optional
# for a node on the same machine as a development central service.

# The token from the cloud portal's Nodes page. Registers this node under your
# account. Required against a service running NODE_REGISTRATION=token.
ARRR_NODE_TOKEN=

# The cloud service to register with.
CENTRAL_SERVICE_URL=https://nodes.arrr.fun

# Shown in the portal and on the dashboard.
NODE_NAME=my-node
NODE_PORT=8001

# How the outside world reaches this node. Both must be publicly reachable:
# browsers connect to NODE_PUBLIC_URL, and the cloud service and other nodes
# call NODE_API_PUBLIC_URL. Behind a home router, forward the port or run a
# tunnel that gives you a public hostname, and put that hostname here.
NODE_PUBLIC_URL=wss://node.example.com/ws
NODE_API_PUBLIC_URL=https://node.example.com
